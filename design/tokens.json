{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canonical Burner List design decisions. Edit this file, then run node scripts/generate-design-tokens.mjs.",
  "theme": {
    "default": {
      "color": {
        "$type": "color",
        "bg": { "$value": "#e8e0d4" },
        "paper": { "$value": "#fffdf7" },
        "fieldSurface": { "$value": "#ffffff" },
        "border": { "$value": "#e8e2d9" },
        "borderStrong": { "$value": "#d6d0c6" },
        "textDark": { "$value": "#3a3530" },
        "textMid": { "$value": "#6b6258" },
        "textSoft": { "$value": "#c0afa7" },
        "textFaint": { "$value": "#b5ad9f" },
        "textFaintest": { "$value": "#c5b9b0" },
        "hoverTint": { "$value": "rgba(180,165,140,0.08)" },
        "hoverTintStrong": { "$value": "rgba(180,165,140,0.18)" },
        "danger": { "$value": "#b04040" },
        "success": { "$value": "#6f8a54" }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "bg": { "$value": "#151412" },
        "paper": { "$value": "#1c1a17" },
        "fieldSurface": { "$value": "#25211d" },
        "border": { "$value": "#312e29" },
        "borderStrong": { "$value": "#47423b" },
        "textDark": { "$value": "#f4eee5" },
        "textMid": { "$value": "#c8bcae" },
        "textSoft": { "$value": "#a09588" },
        "textFaint": { "$value": "#8d8479" },
        "textFaintest": { "$value": "#766e65" },
        "hoverTint": { "$value": "rgba(255,245,230,0.06)" },
        "hoverTintStrong": { "$value": "rgba(255,245,230,0.12)" },
        "danger": { "$value": "#e07a7a" },
        "success": { "$value": "#9bb67c" }
      }
    },
    "slate": {
      "color": {
        "$type": "color",
        "bg": { "$value": "#dde3e6" },
        "paper": { "$value": "#f8fafb" },
        "fieldSurface": { "$value": "#ffffff" },
        "border": { "$value": "#e1e7ea" },
        "borderStrong": { "$value": "#c3ced3" },
        "textDark": { "$value": "#2f3a3e" },
        "textMid": { "$value": "#54676d" },
        "textSoft": { "$value": "#80949a" },
        "textFaint": { "$value": "#9eb0b5" },
        "textFaintest": { "$value": "#b3c2c6" },
        "hoverTint": { "$value": "rgba(120,150,160,0.08)" },
        "hoverTintStrong": { "$value": "rgba(120,150,160,0.18)" }
      }
    },
    "clay": {
      "color": {
        "$type": "color",
        "bg": { "$value": "#ead9d0" },
        "paper": { "$value": "#fdf8f5" },
        "fieldSurface": { "$value": "#ffffff" },
        "border": { "$value": "#ece0d8" },
        "borderStrong": { "$value": "#d9c4b6" },
        "textDark": { "$value": "#3e2f28" },
        "textMid": { "$value": "#6e564a" },
        "textSoft": { "$value": "#9c8276" },
        "textFaint": { "$value": "#b59c8e" },
        "textFaintest": { "$value": "#c8b1a4" },
        "hoverTint": { "$value": "rgba(180,140,120,0.08)" },
        "hoverTintStrong": { "$value": "rgba(180,140,120,0.18)" }
      }
    },
    "lavender": {
      "color": {
        "$type": "color",
        "bg": { "$value": "#e2dde8" },
        "paper": { "$value": "#faf8fc" },
        "fieldSurface": { "$value": "#ffffff" },
        "border": { "$value": "#e6e1ec" },
        "borderStrong": { "$value": "#cfc5d8" },
        "textDark": { "$value": "#352f3c" },
        "textMid": { "$value": "#61566d" },
        "textSoft": { "$value": "#8c8198" },
        "textFaint": { "$value": "#a89db3" },
        "textFaintest": { "$value": "#bcb0c6" },
        "hoverTint": { "$value": "rgba(150,130,170,0.08)" },
        "hoverTintStrong": { "$value": "rgba(150,130,170,0.18)" }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 5, "unit": "px" } },
    "md": { "$value": { "value": 6, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } }
  },
  "layout": {
    "$type": "dimension",
    "zoneContentMax": { "$value": { "value": 464, "unit": "px" } },
    "authWordmarkWidth": { "$value": { "value": 220, "unit": "px" } }
  }
}
